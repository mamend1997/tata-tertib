# ==== SMART TATA TERTIB SISWA — konfigurasi lingkungan ====
# Semua variabel bersifat opsional. Nilai bawaan sudah cukup untuk VPS tunggal.

# Port HTTP aplikasi (platform VibeCoder mengisinya otomatis)
PORT=3000

# Lokasi berkas SQLite (bawaan: ./data/tata-tertib.sqlite)
# DB_PATH=/opt/simkeu-tatib/data/tata-tertib.sqlite
# Di Railway, buat Volume lalu mount; saat DB_PATH tidak diatur, aplikasi
# otomatis menyimpan database di RAILWAY_VOLUME_MOUNT_PATH.

# Zona waktu aplikasi (WIB)
APP_TIMEZONE=Asia/Jakarta

# Proxy unggah media platform (token hanya tersedia saat aplikasi dipublikasikan)
APP_MEDIA_URL=http://127.0.0.1:4310
# APP_MEDIA_TOKEN=diisi-otomatis-oleh-platform

# Batas penyimpanan yang ditampilkan di aplikasi (MB)
STORAGE_QUOTA_MB=5120

# ==== MULTI-TENANT / PANEL SUPER ADMIN ====
# Berkas control plane platform (bawaan: ./data/saas.sqlite)
# SAAS_DB_PATH=/opt/tatib/data/saas.sqlite
# Akun Super Admin pertama (dibuat otomatis saat pertama kali dijalankan)
# SAAS_ADMIN_USER=superadmin
# SAAS_ADMIN_PASS=ubah-sandi-ini
# SAAS_ADMIN_EMAIL=admin@sekolah.id
# Nomor WhatsApp pemulihan; untuk akun lama, SAAS_ADMIN_USER harus sesuai username akun.
# SAAS_ADMIN_PHONE=081234567890

# Alamat publik aplikasi (dipakai tautan portal pada pesan WhatsApp)
# APP_BASE_URL=https://contoh.id/tata-tertib

# Gateway WhatsApp (notifikasi tagihan & tiket) — boleh juga diatur di panel Super Admin
# WA_API_URL=https://api.penyedia-wa.com/send
# WA_API_TOKEN=
# WA_API_PAYLOAD={"target":"{phone}","message":"{pesan}"}

# Auto backup Telegram (boleh juga diatur di panel Super Admin)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==== PAYMENT GATEWAY — KASERA PAY ====
# Kredensial di bawah ini MENANG atas nilai di panel Super Admin
# (Pengaturan → QRIS & Harga).
# API Key dikirim sebagai header: Authorization: Bearer <KASERA_API_KEY>
# KASERA_API_KEY=
# Secret verifikasi webhook:
#   kasera-signature-v1 = HMAC-SHA256(body mentah, KASERA_WEBHOOK_SECRET)
# KASERA_WEBHOOK_SECRET=
# Base URL API (bawaan: production https://pay.kasera.id · sandbox https://sandbox.kasera.id)
# KASERA_BASE_URL=
